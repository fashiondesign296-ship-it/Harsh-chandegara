# --- Database (PostgreSQL: Neon / Supabase free tier work well) ---
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/arshu?sslmode=require"

# --- Auth ---
# Generate with: openssl rand -base64 48
SESSION_SECRET=""
# Used ONLY by `npm run db:seed` to create the first admin. Remove after seeding.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""

# --- Media storage (S3-compatible; Cloudflare R2 has a free tier) ---
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
MEDIA_PUBLIC_HOST=""   # e.g. pub-xxxx.r2.dev or media.yourdomain.com

# --- AI (free tiers / local only) ---
# one of: gemini | groq | ollama
AI_PROVIDER="gemini"
GEMINI_API_KEY=""      # Google AI Studio free tier
GEMINI_MODEL="gemini-1.5-flash"
GROQ_API_KEY=""        # Groq free tier
GROQ_MODEL="llama-3.1-8b-instant"
OLLAMA_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.1"

NEXT_PUBLIC_SITE_URL="http://localhost:3000"
